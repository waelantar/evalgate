# Local-only defaults. Copy to .env only to override them.
POSTGRES_DB=evalgate
POSTGRES_USER=evalgate
POSTGRES_PASSWORD=evalgate_local_only
POSTGRES_PORT=5432

EVALGATE_ENVIRONMENT=local
EVALGATE_DATABASE_URL=postgresql+psycopg://evalgate:evalgate_local_only@127.0.0.1:5432/evalgate
EVALGATE_HOST=127.0.0.1
EVALGATE_PORT=8000
EVALGATE_LOG_LEVEL=INFO
EVALGATE_EMBEDDING_MODE=fixture
EVALGATE_GENERATION_MODE=fixture
EVALGATE_ALLOWED_ORIGINS=http://localhost:5173
EVALGATE_TRUSTED_PROXY_ADDRESSES=
EVALGATE_REQUEST_BODY_LIMIT_BYTES=16384
EVALGATE_REQUEST_TIMEOUT_SECONDS=30
EVALGATE_RATE_IDENTITY_TTL_SECONDS=300
EVALGATE_LIVE_EVAL_BUDGET_USD=4.60
EVALGATE_LIVE_EVAL_STOP_USD=4.14

# Public mode additionally requires an exact HTTPS origin and a random server-only
# value of at least 32 bytes. Keep the real value in the runtime secret store.
# EVALGATE_ALLOWED_ORIGINS=https://evalgate.example
# EVALGATE_RATE_IDENTITY_SECRET=replace-with-a-random-server-secret

# EG-015 live evaluation only:
# EVALGATE_LIVE_PROVIDER=openrouter
# EVALGATE_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# EVALGATE_OPENROUTER_API_KEY=sk-or-v1-...

# Fixture modes are explicit and prove mechanics only. Reference embedding mode
# also requires EVALGATE_REFERENCE_EMBEDDING_SNAPSHOT to name a pre-provisioned
# local snapshot; the verifier must accept it before any runtime is constructed.
# Live generation is available only after the EG-015 provider decision. Use
# EVALGATE_LIVE_PROVIDER=openrouter with the approved model and keep the real
# OpenRouter API key only in an ignored local .env file or a protected secret;
# credentials must never be committed.
