{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalgate:schema:evaluation-artifact:1",
  "title": "EvalGate evaluation artifact envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "versions", "environment", "metrics", "cases", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_key", "mode", "status", "started_at", "finished_at"],
      "properties": {
        "run_key": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mode": { "enum": ["fixture_contract", "retrieval", "generation"] },
        "status": { "enum": ["completed", "failed", "cancelled"] },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_sha", "corpus_manifest_sha256", "index_key", "dataset_manifest_sha256", "policy_version"],
      "properties": {
        "code_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "index_key": { "type": "string", "minLength": 1, "maxLength": 160 },
        "dataset_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "prompt_sha256": { "$ref": "#/$defs/sha256" },
        "generation_model": { "type": "string", "maxLength": 160 },
        "judge_model": { "type": "string", "maxLength": 160 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python", "postgres_image_digest", "numeric_tolerance"],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "python": { "type": "string" },
        "fastembed": { "type": "string" },
        "onnxruntime": { "type": "string" },
        "postgres_image_digest": { "type": "string" },
        "numeric_tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "cases": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "retrieved_evidence_ids", "relevant_evidence_ids"],
            "properties": {
              "case_id": { "type": "string", "minLength": 1, "maxLength": 120 },
              "retrieved_evidence_ids": { "$ref": "#/$defs/evidence_id_array" },
              "relevant_evidence_ids": { "$ref": "#/$defs/evidence_id_array" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "split", "question", "answerability", "relevant_evidence_ids", "supported_claims", "review_state"],
            "properties": {
              "case_id": { "type": "string", "minLength": 1, "maxLength": 120 },
              "split": { "enum": ["development", "calibration", "regression"] },
              "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "answerability": { "enum": ["answerable", "unanswerable"] },
              "relevant_evidence_ids": { "$ref": "#/$defs/evidence_id_array" },
              "supported_claims": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 120 }
              },
              "review_state": { "const": "reviewed" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "split", "answerability", "relevant_evidence_ids", "supported_claims", "repetitions"],
            "properties": {
              "case_id": { "type": "string", "minLength": 1, "maxLength": 120 },
              "split": { "enum": ["development", "calibration", "regression"] },
              "answerability": { "enum": ["answerable", "unanswerable"] },
              "relevant_evidence_ids": { "$ref": "#/$defs/evidence_id_array" },
              "supported_claims": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 120 }
              },
              "repetitions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["repetition", "answer_status", "retrieved_evidence_ids", "citation_evidence_ids", "generation_usage", "judge_decision", "judge_reason_code", "judge_usage", "human_label", "passed"],
                  "properties": {
                    "repetition": { "type": "integer", "minimum": 1 },
                    "answer_status": {
                      "enum": [
                        "answered",
                        "insufficient_support",
                        "provider_unavailable",
                        "provider_timeout",
                        "malformed_output",
                        "citation_missing",
                        "citation_spoofed",
                        "context_invalid",
                        "evidence_invalid"
                      ]
                    },
                    "retrieved_evidence_ids": { "$ref": "#/$defs/evidence_id_array" },
                    "citation_evidence_ids": { "$ref": "#/$defs/evidence_id_array" },
                    "generation_usage": { "$ref": "#/$defs/live_usage" },
                    "judge_decision": { "enum": ["pass", "fail"] },
                    "judge_reason_code": {
                      "enum": [
                        "supported_answer",
                        "correct_insufficient_support",
                        "wrong_answerability",
                        "missing_relevant_citation",
                        "unsupported_claim",
                        "provider_unavailable",
                        "provider_timeout",
                        "malformed_output",
                        "citation_invalid",
                        "context_invalid",
                        "judge_invalid"
                      ]
                    },
                    "judge_usage": { "$ref": "#/$defs/live_usage" },
                    "human_label": { "enum": ["pass", "fail"] },
                    "passed": { "type": "boolean" }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_id_array": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "live_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "cost_usd"],
      "properties": {
        "input_tokens": { "type": "number", "minimum": 0 },
        "output_tokens": { "type": "number", "minimum": 0 },
        "total_tokens": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
