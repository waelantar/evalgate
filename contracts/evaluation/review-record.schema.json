{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalgate:schema:evaluation-review-record:1",
  "title": "EvalGate evaluation artifact review record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_sha256", "dataset_manifest_sha256", "decision", "reviewer_role", "reviewed_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "dataset_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "decision": { "const": "approved" },
    "reviewer_role": { "type": "string", "minLength": 1, "maxLength": 80 },
    "reviewed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
