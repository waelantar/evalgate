{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/evalgate/contracts/release/eg-013d-evidence.schema.json",
  "title": "EvalGate EG-013D release-candidate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story", "product_version", "image", "publication"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "story": { "const": "EG-013D" },
    "product_version": { "type": "string", "pattern": "^0\\.9\\.0$" },
    "image": { "type": "string", "minLength": 1 },
    "image_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "configured_user": { "const": "10001:10001" },
    "publication": { "const": "not_pushed_not_deployed" }
  }
}
