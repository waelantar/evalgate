{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evalgate:schema:corpus-manifest:1",
  "title": "EvalGate corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_key", "version", "license", "documents"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "corpus_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "license": { "const": "CC0-1.0" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "title", "path", "media_type", "license", "sha256", "provenance"],
      "properties": {
        "source_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,95}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "path": { "type": "string", "pattern": "^documents/[a-z0-9/_-]+\\.md$" },
        "media_type": { "const": "text/markdown" },
        "license": { "const": "CC0-1.0" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "provenance": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
